# Klovah — environment placeholders.
# No environment variables are required today.
# The contact form uses a mailto: fallback; there is no backend, CMS, or analytics.
#
# Copy to .env locally if you need a file present:
#   cp .env.example .env   (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Future production form endpoint (NOT yet wired — see ContactPage.tsx):
# VITE_FORM_ENDPOINT=
# Future analytics ID (NOT yet integrated):
# VITE_ANALYTICS_ID=
